[Unit]
Description=ZynAddSubFX Alternative Service
After=wireplumber-root.service pipewire-root.service pipewire-pulse-root.service zynaddsubfx.service
Requires=wireplumber-root.service pipewire-root.service pipewire-pulse-root.service

[Service]
Type=simple
User=root
Group=root
Environment=XDG_RUNTIME_DIR=/run/pipewire
WorkingDirectory=/root
#ExecStart=/usr/bin/pw-jack /usr/bin/zynaddsubfx -I JACK -O JACK --sample-rate=48000 --no-gui --load-instrument=/root/0065-simple-brass.xiz
ExecStart=/usr/bin/pw-jack /usr/bin/zynaddsubfx -I JACK -O JACK --sample-rate=48000 --no-gui --load-instrument=/root/0066-fat-brass.xiz
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
